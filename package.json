{
  "name": "otoservis",
  "version": "0.1.0",
  "private": true,
  "description": "Professional Auto Service Management Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @otoservis/database db:migrate",
    "db:migrate:dev": "pnpm --filter @otoservis/database db:migrate:dev",
    "db:seed": "pnpm --filter @otoservis/database db:seed",
    "db:generate": "pnpm --filter @otoservis/database db:generate",
    "db:studio": "pnpm --filter @otoservis/database db:studio",
    "db:setup": "pnpm db:migrate:dev; pnpm db:seed",
    "docker:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@swc/core",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ]
  }
}
