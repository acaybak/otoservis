# Database
DATABASE_URL=postgresql://otoservis:otoservis_dev_password@localhost:5433/otoservis?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Server
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
