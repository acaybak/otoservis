{
  "name": "@otoservis/desktop",
  "version": "0.1.3",
  "private": true,
  "author": "OtoServis",
  "description": "OtoServis - Çevrimdışı çalışan servis yönetim sistemi",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "tsc --noEmit && vite build && electron-builder --win nsis",
    "release": "tsc --noEmit && vite build && electron-builder --win nsis --publish always",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist release"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@otoservis/types": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.otoservis.desktop",
    "productName": "OtoServis",
    "artifactName": "OtoServis-Setup.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "acaybak",
        "repo": "otoservis",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OtoServis",
      "installerLanguages": ["tr_TR", "en_US"]
    }
  }
}
